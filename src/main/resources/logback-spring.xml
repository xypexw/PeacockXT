<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- ================================================== -->
    <!-- 1. APPLICATION PROPERTIES                          -->
    <!-- ================================================== -->

    <springProperty
            scope="context"
            name="APP_NAME"
            source="spring.application.name"
            defaultValue="PeacockXT"/>

    <property name="LOG_PATH" value="/var/log/peacock"/>
    <property name="LOG_FILE_NAME" value="application"/>

    <!-- One shared pattern for Console and File -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{traceId:-},%X{userId:-}] [%t] %-40.40logger{39} : %m%n"/>

    <!-- ================================================== -->
    <!-- 2. SYNCHRONOUS FILE APPENDER                       -->
    <!-- ================================================== -->

    <appender name="FILE_SYNC"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>

        </rollingPolicy>
    </appender>

    <!-- ================================================== -->
    <!-- 3. ASYNC FILE APPENDER                              -->
    <!-- ================================================== -->

    <appender name="ASYNC_FILE"
              class="ch.qos.logback.classic.AsyncAppender">

        <appender-ref ref="FILE_SYNC"/>

        <!-- Buffer log events to keep file I/O off request threads -->
        <queueSize>8192</queueSize>

        <!-- Preserve INFO/WARN/ERROR under queue pressure -->
        <discardingThreshold>0</discardingThreshold>

        <!-- Avoid caller stack inspection on every log event -->
        <includeCallerData>false</includeCallerData>

        <!-- Never block application threads when queue is full -->
        <neverBlock>true</neverBlock>

        <!-- Give the worker time to flush on application shutdown -->
        <maxFlushTime>10000</maxFlushTime>

    </appender>

    <!-- ================================================== -->
    <!-- 4. CONSOLE APPENDER                                -->
    <!-- ================================================== -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

    </appender>

    <!-- ================================================== -->
    <!-- 5. ENVIRONMENT PROFILES                             -->
    <!-- ================================================== -->

    <!-- Development: Console + asynchronous file -->
    <springProfile name="dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- Production / load testing: asynchronous file only -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

</configuration>